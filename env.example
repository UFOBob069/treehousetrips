# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Application Fee Price ID (create this in your Stripe dashboard)
STRIPE_APPLICATION_PRICE_ID=price_1234567890

# App Configuration (canonical URL for sitemap, robots, Stripe redirects)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional Stripe Checkout product image (HTTPS). Omit for faster checkout load.
# STRIPE_CHECKOUT_PRODUCT_IMAGE=https://yoursite.com/images/checkout-product.jpg
# STRIPE_CHECKOUT_LOGO_URL=https://yoursite.com/logo.png

# Map Configuration (Optional - for Google Maps embed)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
